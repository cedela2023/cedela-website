# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.cedelatechpark.ng

# ---------------------------------------------------------------------------
# Sanity (https://www.sanity.io/manage)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-10-01
# Viewer token: enables draft previews and live preview in the Presentation tool
SANITY_API_READ_TOKEN=
# Editor token: only needed to run `npm run seed`
SANITY_API_WRITE_TOKEN=
# Optional: secret for the /api/revalidate webhook (safety net alongside Sanity Live)
SANITY_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Resend (https://resend.com)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Must use a domain verified in Resend, for example: CEDELA <website@cedelatechpark.ng>
RESEND_FROM_EMAIL=CEDELA Website <website@cedelatechpark.ng>
# Optional: Resend segment ID for newsletter subscribers
RESEND_SEGMENT_ID=

# Inbox routing (all fall back to CONTACT_INBOX)
CONTACT_INBOX=info@cedelatechpark.ng
BUSINESS_INBOX=
MEDIA_INBOX=
CAREERS_INBOX=
INVESTORS_INBOX=
PARTNERSHIPS_INBOX=
# iRES incident reports. Use a monitored, 24/7 inbox or distribution list.
IRES_INBOX=

# ---------------------------------------------------------------------------
# Client portal (optional). When set, the portal page links to this sign-in URL.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PORTAL_URL=

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
